{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "uv run --python $CLAUDE_PROJECT_DIR/.venv/bin/python $CLAUDE_PROJECT_DIR/.claude/hooks/agent-merge-on-end.py",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.claude/handoff/**)",
      "Read(./.claude/backups/**)"
    ]
  }
}
