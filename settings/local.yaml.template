# Local Configuration Overrides (Template)
# Copy this file to settings/local.yaml and customize for your environment.
# settings/local.yaml is gitignored and has highest priority.

# === Example Local Overrides ===

# Enable debug mode for development
# enable_debug_mode: true
# log_level: "DEBUG"
# enable_performance_logging: true

# Custom database location
# database_path: "~/custom/path/reflection.duckdb"
# data_dir: "~/custom/data"
# log_dir: "~/custom/logs"

# Development server settings
# server_port: 3001
# enable_hot_reload: true

# Disable certain features for testing
# enable_semantic_search: false
# enable_auto_commit: false

# Custom logging
# log_file_path: "~/custom/logs/session-mgmt.log"
# slow_query_threshold: 0.5

# Optional LLM API keys (prefer environment variables)
# openai_api_key: "sk-..."
# anthropic_api_key: "sk-ant-..."
# gemini_api_key: "..."

# Enable GCS-backed storage (uncomment to use fake-gcs-server or real GCS):
# storage:
#   default_backend: "gcs"
#   gcs:
#     bucket_name: "my-dev-bucket"
#     endpoint_url: "http://127.0.0.1:4443"
#     project: "my-gcp-project"
#     credentials_path: "/path/to/service-account.json"

